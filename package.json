{
  "name": "solana-ultra-fast-trader",
  "version": "2.0.0",
  "description": "⚡ Ultra-Fast Solana Trading Engine - Sub-second execution",
  "main": "main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/sniper.js",
    "service": "ts-node --transpile-only src/snipeService.ts",
    "snipe": "ts-node --transpile-only src/sniper.ts",
    "dev": "ts-node --transpile-only --cache-directory .ts-cache src/snipeService.ts",
    "compile": "tsc && echo '⚡ Ultra-Fast Engine compiled'",
    "service-compiled": "npm run compile && node dist/snipeService.js",
    
    "ultra-build": "tsc --incremental && echo '🚀 Ultra-Fast build completed'",
    "ultra-dev": "electron main.js --enable-logging",
    "ultra-start": "npm run ultra-build && npm run ultra-dev",
    "ultra-fast": "npm run ultra-build && electron main.js --no-sandbox --disable-web-security",
    
    "electron": "npm run build && electron main.js",
    "electron-dev": "electron main.js",
    "electron-debug": "electron main.js --inspect=9229",
    "dist": "npm run ultra-build && electron-builder",
    
    "preload": "node -e \"console.log('🔥 Preloading dependencies...'); require('./dist/services/analysis'); require('./dist/services/jupiter'); require('./dist/utils/wallet'); console.log('✅ Preload complete');\"",
    "benchmark": "node -e \"console.time('Startup'); require('./main.js'); console.timeEnd('Startup');\""
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "skipLibCheck": true,
      "esModuleInterop": true,
      "incremental": true,
      "tsBuildInfoFile": ".tsbuildinfo"
    }
  },
  "keywords": [
    "solana",
    "trading",
    "defi",
    "ultra-fast",
    "scalping",
    "memecoin",
    "sniper"
  ],
  "author": "Ultra-Fast Trader",
  "license": "ISC",
  "dependencies": {
    "@jup-ag/api": "^6.0.44",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "axios": "^1.10.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "chalk": "^5.4.1",
    "dotenv": "^17.0.0",
    "ed25519-hd-key": "^1.3.0",
    "open": "^10.1.2",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.8",
    "@types/readline-sync": "^1.4.8",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.ultrafast.solana-trader",
    "productName": "Ultra-Fast Solana Trader",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "renderer.html",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Ultra-Fast Solana Trader",
        "executableName": "ultra-fast-trader"
      }
    }
  }
}